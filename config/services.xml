<?xml version="1.0" encoding="utf-8" ?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <imports>
        <import resource="services/**/*.xml" />
    </imports>
    <services>
        <defaults public="false" autowire="false" autoconfigure="false"/>

        <service id="bitbag_sylius_banner_plugin.filesystem.image" class="Sylius\Component\Core\Filesystem\Adapter\FlysystemFilesystemAdapter">
            <argument type="service" id="bitbag_sylius_banner_plugin.image.storage" />
        </service>
    </services>
</container>
